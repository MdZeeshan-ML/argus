# .env.example — Copy this to .env and fill in your values
# NEVER commit .env — it is in .gitignore

# NVIDIA NIM (cloud inference)
NIM_API_KEY=your_nim_api_key_here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=moonshotai/kimi-k2-instruct

# Ollama (local inference)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:3b

# Default inference mode: "local" or "cloud"
DEFAULT_MODE=cloud

# Email (IMAP)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
EMAIL_ADDRESS=your_email@gmail.com
# Use Gmail App Password, not your real password
# Generate at: myaccount.google.com/apppasswords
EMAIL_PASSWORD=your_app_password_here
EMAIL_POLL_INTERVAL_MINUTES=15

# Google Cloud
GCP_PROJECT_ID=argus-personal
GCS_BUCKET_NAME=argus-logs-youruid
GDRIVE_FOLDER_ID=your_google_drive_folder_id_here
BIGQUERY_DATASET=argus_personal
BIGQUERY_TABLE=incidents
# Path to service account JSON — outside project directory
GCP_CREDENTIALS_PATH=C:\Users\YourName\.argus\credentials\service_account.json

# Argus local paths
ARGUS_HOME=C:\Users\YourName\.argus
QUARANTINE_DIR=C:\Users\YourName\.argus\quarantine
CHROMA_DB_DIR=C:\Users\YourName\.argus\chroma_db
SQLITE_DB_PATH=C:\Users\YourName\.argus\argus.db
WHITELIST_PATH=C:\Users\YourName\.argus\whitelist.json

# GUI
GUI_PORT=7734
GUI_HOST=localhost

# VirusTotal (Gate 1.5 — optional, Gate 1.5 skips gracefully if not set)
# Free tier: 4 req/min, 500/day. Get key at: virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# Threat feeds (update schedule in hours)
PHISHTANK_UPDATE_HOURS=6
OPENPHISH_UPDATE_HOURS=6
MALWAREBAZAAR_UPDATE_HOURS=24

# Report
DAILY_REPORT_TIME=23:55

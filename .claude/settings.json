{
  "permissions": {
    "allow": [
      "Bash(python -m argus.*)",
      "Bash(python tests/adversarial/*.py)",
      "Bash(python tests/adversarial/run_all.py)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./configs/config.json)",
      "Read(./configs/service_account.json)",
      "Read(./data/personal_whitelist.json)",
      "Read(./data/my_clients.json)",
      "Bash(rm -rf *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git checkout *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/run-module-tests.sh",
            "timeout": 40,
            "statusMessage": "Running module self-test..."
          }
        ]
      }
    ]
  }
}
